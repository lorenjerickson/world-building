generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model World {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceExternalId String?  @db.VarChar
  ownerSubject         String?  @db.VarChar
  name                 String?  @db.VarChar
  description          String?  @db.Text
  ruleSetId            Int?
  releaseId            Int?
  releaseHash          String?  @db.VarChar
  prompt               String?  @db.VarChar
  generatedContent     String?  @db.Text
  metadata             Json?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([workspaceExternalId, ownerSubject], map: "IDX_world_workspace_owner")
  @@map("worlds")
}

model SearchDocument {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String                   @db.VarChar
  recordType     String                   @db.VarChar
  recordId       String                   @db.VarChar
  title          String                   @db.VarChar
  summary        String                   @db.Text
  href           String                   @db.VarChar
  searchableText String                   @db.Text
  searchVector   Unsupported("tsvector")?
  updatedAt      DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([actorId, recordType, recordId], map: "UQ_search_document_actor_record")
  @@index([actorId], map: "IDX_search_document_actor")
  @@map("search_documents")
}

model RuleSetComposition {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceExternalId String                     @db.VarChar
  manifest            Json
  compositionHash     String                     @db.VarChar
  engineVersion       String                     @db.VarChar
  compilerVersion     String                     @db.VarChar
  validationSummary   Json?
  createdBy           String                     @db.VarChar
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  members             RuleSetCompositionMember[]
  bindings            RuleSetBinding[]

  @@unique([workspaceExternalId, compositionHash], map: "UQ_rule_set_composition_workspace_hash")
  @@index([workspaceExternalId], map: "IDX_rule_set_composition_workspace")
  @@index([compositionHash], map: "IDX_rule_set_composition_hash")
  @@map("rule_set_compositions")
}

model RuleSetCompositionMember {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compositionId  String             @db.Uuid
  ruleSetId      Int
  releaseId      Int
  releaseHash    String             @db.VarChar
  namespaceAlias String             @db.VarChar
  sortOrder      Int
  policy         Json               @default("{}")
  composition    RuleSetComposition @relation(fields: [compositionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([compositionId, namespaceAlias], map: "UQ_rule_set_member_namespace")
  @@unique([compositionId, sortOrder], map: "UQ_rule_set_member_order")
  @@map("rule_set_composition_members")
}

model RuleSetBinding {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceExternalId String                @db.VarChar
  scopeType           String                @db.VarChar
  scopeId             String                @db.VarChar
  gameplayProfileName String                @db.VarChar
  compositionId       String                @db.Uuid
  compositionHash     String                @db.VarChar
  active              Boolean               @default(false)
  stateVersion        BigInt                @default(1)
  status              String                @default("active") @db.VarChar
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  composition         RuleSetComposition    @relation(fields: [compositionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  instances           RuleInstance[]
  effects             RuleEffect[]
  executions          RuleExecution[]
  events              RuleEvent[]
  artifactContexts    ArtifactRuleContext[]

  @@unique([scopeType, scopeId, gameplayProfileName], map: "UQ_rule_set_binding_profile")
  @@index([workspaceExternalId], map: "IDX_rule_set_binding_workspace")
  @@map("rule_set_bindings")
}

model RuleInstance {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bindingId              String                 @db.Uuid
  typeId                 String                 @db.VarChar
  rootTraitIds           String[]               @default([])
  satisfiedTraitIds      String[]               @default([])
  prerequisiteSelections Json                   @default("{}")
  migrationStatus        String                 @default("current") @db.VarChar
  migrationDiagnostics   Json                   @default("[]")
  retainedValues         Json                   @default("{}")
  state                  Json
  stateVersion           BigInt                 @default(1)
  createdBy              String                 @db.VarChar
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  binding                RuleSetBinding         @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outgoingReferences     WorldEntityReference[] @relation("WorldEntityReferenceParent")
  incomingReferences     WorldEntityReference[] @relation("WorldEntityReferenceChild")

  @@index([bindingId, typeId], map: "IDX_rule_instance_binding_type")
  @@index([bindingId, migrationStatus], map: "IDX_rule_instance_binding_migration_status")
  @@map("rule_instances")
}

model WorldEntityReference {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bindingId         String       @db.Uuid
  parentEntityId    String       @db.Uuid
  childEntityId     String       @db.Uuid
  collectionPath    String       @db.VarChar
  sortOrder         Int          @default(0)
  implementationMap Json         @default("{}")
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  parentEntity      RuleInstance @relation("WorldEntityReferenceParent", fields: [parentEntityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  childEntity       RuleInstance @relation("WorldEntityReferenceChild", fields: [childEntityId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([parentEntityId, collectionPath, childEntityId], map: "UQ_world_entity_reference_parent_path_child")
  @@index([bindingId, parentEntityId, collectionPath, sortOrder], map: "IDX_world_entity_reference_collection")
  @@index([childEntityId], map: "IDX_world_entity_reference_child")
  @@map("world_entity_references")
}

model RuleEffect {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bindingId    String         @db.Uuid
  targetId     String         @db.VarChar
  definitionId String         @db.VarChar
  sourceRef    Json
  state        Json
  expiresAt    DateTime?      @db.Timestamptz(6)
  stateVersion BigInt         @default(1)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  binding      RuleSetBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bindingId, targetId], map: "IDX_rule_effect_binding_target")
  @@index([bindingId, expiresAt], map: "IDX_rule_effect_binding_expiry")
  @@map("rule_effects")
}

model RuleExecution {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bindingId      String             @db.Uuid
  operationId    String             @db.VarChar
  actorId        String             @db.VarChar
  idempotencyKey String             @db.VarChar
  input          Json
  result         Json?
  traceRef       String?            @db.VarChar
  status         String             @default("pending") @db.VarChar
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  binding        RuleSetBinding     @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  continuations  RuleContinuation[]

  @@unique([bindingId, actorId, idempotencyKey], map: "UQ_rule_execution_idempotency")
  @@map("rule_executions")
}

model RuleEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bindingId     String         @db.Uuid
  sequence      BigInt
  eventTypeId   String         @db.VarChar
  visibility    String         @default("public") @db.VarChar
  payload       Json
  causationId   String?        @db.Uuid
  correlationId String?        @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  binding       RuleSetBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([bindingId, sequence], map: "UQ_rule_event_sequence")
  @@map("rule_events")
}

model RuleContinuation {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId          String        @db.Uuid
  stepId               String        @db.VarChar
  state                Json
  authorizedResponders Json
  expiresAt            DateTime      @db.Timestamptz(6)
  status               String        @default("pending") @db.VarChar
  stateVersion         BigInt        @default(1)
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  execution            RuleExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([executionId], map: "IDX_rule_continuation_execution")
  @@index([status, expiresAt], map: "IDX_rule_continuation_status_expiry")
  @@map("rule_continuations")
}

model RuleArtifact {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactHash             String   @unique @db.VarChar
  releaseOrCompositionHash String   @db.VarChar
  engineVersion            String   @db.VarChar
  artifactLocation         String   @db.VarChar
  validationSummary        Json
  compiledAt               DateTime @default(now()) @db.Timestamptz(6)

  @@unique([releaseOrCompositionHash, engineVersion], map: "UQ_rule_artifact_source_engine")
  @@map("rule_artifacts")
}

model ArtifactRuleContext {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactId          String          @db.VarChar
  generationJobId     String          @db.VarChar
  bindingId           String?         @db.Uuid
  compositionHash     String          @db.VarChar
  policyHash          String          @db.VarChar
  applicableReleases  Json
  context             Json
  applicabilityStatus String          @default("applicable") @db.VarChar
  validationSummary   Json
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  binding             RuleSetBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([artifactId, compositionHash], map: "IDX_artifact_rule_context_artifact_composition")
  @@index([generationJobId], map: "IDX_artifact_rule_context_job")
  @@map("artifact_rule_contexts")
}

model RuleAuthoringSession {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleSetId       Int
  draftId         String                  @db.VarChar
  actorId         String                  @db.VarChar
  baseRevision    String                  @db.VarChar
  status          String                  @default("active") @db.VarChar
  modelMetadata   Json
  retentionPolicy Json
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  proposals       RuleAuthoringProposal[]

  @@index([ruleSetId, draftId, actorId], map: "IDX_rule_authoring_session_context")
  @@map("rule_authoring_sessions")
}

model RuleAuthoringProposal {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String               @db.Uuid
  baseRevision      String               @db.VarChar
  proposalHash      String               @db.VarChar
  patch             Json
  assumptions       Json
  validationSummary Json
  status            String               @default("proposed") @db.VarChar
  decisionBy        String?              @db.VarChar
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  session           RuleAuthoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, proposalHash], map: "UQ_rule_authoring_proposal_hash")
  @@map("rule_authoring_proposals")
}

model RuleDefinitionSnapshot {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleSetId            Int
  definitionId         Int
  definitionExternalId String   @db.VarChar
  name                 String   @db.VarChar
  body                 Json
  reason               String   @default("autosave") @db.VarChar
  actorId              String   @db.VarChar
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  @@index([definitionId], map: "IDX_rule_def_snapshot_definition")
  @@index([ruleSetId, definitionId, createdAt(sort: Desc)], map: "IDX_rule_def_snapshot_ruleset_def_time")
  @@map("rule_definition_snapshots")
}
