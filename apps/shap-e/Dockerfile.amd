# syntax=docker/dockerfile:1.7

FROM rocm/pytorch:rocm7.2.4_ubuntu22.04_py3.10_pytorch_release_2.9.1 AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt constraints.amd.txt ./
RUN python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venv/bin/python -m pip install --no-cache-dir \
      -c constraints.amd.txt -r requirements.txt

COPY app.py .
RUN /opt/venv/bin/python -m compileall -q app.py


FROM rocm/pytorch:rocm7.2.4_ubuntu22.04_py3.10_pytorch_release_2.9.1 AS runtime

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SHAP_E_ACCELERATOR=amd \
    SHAP_E_DEVICE=cuda \
    SHAP_E_MODEL_CACHE=/models

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 shape \
    && useradd --uid 10001 --gid shape --create-home --shell /usr/sbin/nologin shape \
    && mkdir -p /app /models \
    && chown shape:shape /app /models

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=shape:shape /build/app.py /app/app.py

WORKDIR /app
USER shape
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15m --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=4)"]
STOPSIGNAL SIGTERM
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
