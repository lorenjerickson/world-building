# Auth0 Configuration
# Replace these with your actual Auth0 application values.
# AUTH0_SECRET can be generated using: openssl rand -hex 32
AUTH0_SECRET='7c1d763ea17b8f9e0a0a552c9388df671ee6a8551f33f0a996778f3de7492c10'
AUTH0_BASE_URL='https://local.web.wanderlust-vtt.com:8443'
AUTH0_ISSUER_BASE_URL='https://YOUR_TENANT.us.auth0.com'
AUTH0_CLIENT_ID='YOUR_CLIENT_ID'
AUTH0_CLIENT_SECRET='YOUR_CLIENT_SECRET'

# Server-side calls from Next.js to NestJS. NEXT_PUBLIC_API_URL is retained
# for browser-facing URLs; secrets must never use the NEXT_PUBLIC_ prefix.
BACKEND_URL='https://local.api.wanderlust-vtt.com:8444'
NEXT_PUBLIC_API_URL='https://local.api.wanderlust-vtt.com:8444'
RULE_API_INTERNAL_TOKEN='replace-with-the-same-value-used-by-apps-backend'

# Server-only private operator endpoint opened by the Content navigation item.
# Production must point this at a VPN/IAP-protected HTTPS Payload admin URL.
CMS_ADMIN_URL='https://local.cms.wanderlust-vtt.com:3100/admin'
